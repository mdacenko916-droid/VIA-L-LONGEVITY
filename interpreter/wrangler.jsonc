{
	"name": "interpreter",
	"compatibility_date": "2026-05-24",
	"main": "cloudflare-worker.js",
	// Секреты задавать только через `wrangler secret put NAME`, не через `vars`.
	// Действующие секреты: CLAUDE_API_KEY, TELEGRAM_BOT_TOKEN, NUTRITIONIST_CHAT_ID,
	// BREVO_API_KEY, APPS_SCRIPT_URL, HOTMART_TOKEN.
	// Fitbit через Google Health API (см. ARCHITECTURE §16): GHEALTH_CLIENT_ID,
	// GHEALTH_CLIENT_SECRET (Google Cloud Console OAuth Client ID, "Web application").
	// WHOOP (developer.whoop.com): WHOOP_CLIENT_ID, WHOOP_CLIENT_SECRET.
	// Кабинет нутрициолога: секрет CABINET_PASS (пароль входа, НЕ в HTML).
	// Cron Trigger — ежедневная бот-напоминалка клиентам (scheduled() в воркере).
	// 09:00 UTC ≈ 11–12 утра в ЕС (UTC+2/+3). См. runDailyReminders().
	"triggers": {
		"crons": ["0 9 * * *"]
	},
	"kv_namespaces": [
		{
			"binding": "EXPERT_DRAFTS",
			"id": "646385ffc4d445f2b530dc8270249765"
		},
		{
			"binding": "PROGRAM_INTAKES",
			"id": "f7e717d9bd6d4304aac8a28302b1dbfd"
		},
		{
			"binding": "WEARABLE_TOKENS",
			"id": "36f8b47eb7ce4859a30e6abba9c9025e"
		}
	],
	// D1 — кабинет нутрициолога (CRM). Создать: `wrangler d1 create vial-cabinet`,
	// затем вписать выданный database_id ниже и применить cabinet-schema.sql.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vial-cabinet",
			"database_id": "b4ee9324-1206-4648-ba54-4dcaf7aeed65"
		}
	],
	// R2 — файлы чата (голос/фото). Публичный URL bucket'а: pub-2f2f1a44a98c46beabafa751ba849852.r2.dev
	"r2_buckets": [
		{
			"binding": "ASSETS",
			"bucket_name": "vial-assets"
		}
	]
}
