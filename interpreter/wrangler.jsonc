{
	"name": "interpreter",
	"compatibility_date": "2026-05-24",
	"main": "cloudflare-worker.js",
	// Секреты задавать только через `wrangler secret put NAME`, не через `vars`.
	// Действующие секреты: CLAUDE_API_KEY, TELEGRAM_BOT_TOKEN, NUTRITIONIST_CHAT_ID,
	// BREVO_API_KEY, APPS_SCRIPT_URL, HOTMART_TOKEN.
	// Fitbit через Google Health API (см. ARCHITECTURE §16): GHEALTH_CLIENT_ID,
	// GHEALTH_CLIENT_SECRET (Google Cloud Console OAuth Client ID, "Web application").
	"kv_namespaces": [
		{
			"binding": "EXPERT_DRAFTS",
			"id": "646385ffc4d445f2b530dc8270249765"
		},
		{
			"binding": "PROGRAM_INTAKES",
			"id": "f7e717d9bd6d4304aac8a28302b1dbfd"
		},
		{
			"binding": "WEARABLE_TOKENS",
			"id": "36f8b47eb7ce4859a30e6abba9c9025e"
		}
	]
}
