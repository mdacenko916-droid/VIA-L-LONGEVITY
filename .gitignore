.DS_Store
**/.DS_Store
.claude/

# Cloudflare Wrangler local cache / miniflare state (build artifacts, do not commit)
.wrangler/
**/.wrangler/

# ИП: исходные материалы обогащения KB (тяжёлые PDF/видео — провенанс, остаётся локально;
# напр. «Perry Academi» ~882 МБ). Лёгкие текстовые подборки N-1/N-2/N-3 — исключения ниже,
# чтобы больше не терялись при переносе репозитория.
interpreter/Infa Cloude/*
!interpreter/Infa Cloude/N-1/
!interpreter/Infa Cloude/N-2/
!interpreter/Infa Cloude/N-3/
# Рабочие скриншоты (локально)
скрин/

.dev.vars*
!.dev.vars.example
.env*
