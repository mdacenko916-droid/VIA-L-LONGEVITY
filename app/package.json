{
  "name": "vial-interpreter-app",
  "version": "0.1.0",
  "private": true,
  "description": "VIA·L Interpreter — нативное приложение пациента (Capacitor-обёртка веб-ИП)",
  "scripts": {
    "postinstall": "patch-package",
    "sync": "cap sync",
    "setup:ios": "node scripts/setup-ios.js",
    "add:ios": "cap add ios && node scripts/setup-ios.js",
    "add:android": "cap add android",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@perfood/capacitor-healthkit": "1.3.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "patch-package": "^8.0.1"
  }
}
