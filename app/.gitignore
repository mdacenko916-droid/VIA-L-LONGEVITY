# Capacitor / Node — генерится локально, в репо не коммитим
node_modules/

# package-lock.json КОММИТИМ (с 2026-09-09). Пока он был в игноре, Xcode Cloud клонировал
# репозиторий БЕЗ него и звал `npm install` — то есть каждый раз заново разрешал версии по
# кареткам. В какой-то момент RevenueCat выпустил 11.3.2 с другой зависимостью
# PurchasesHybridCommon, облако поставило её, а закоммиченный Podfile.lock был собран под
# старую — и `pod install` падал. Все сборки валились на ci_post_clone.sh, а на машине
# всё собиралось: тут в node_modules лежала нужная версия. Лок в репозитории + `npm ci`
# в CI = облако и машина ставят одно и то же.

# Нативные платформы генерятся командой `npx cap add ios|android` на машине разработчика.
# Якорь `/` — игнорим ТОЛЬКО сгенерённые платформы в корне app, но НЕ нативный код
# локальных плагинов (app/plugins/*/android — это исходники, их коммитим).
/android/

# iOS-проект КОММИТИМ (с 2026-08-31): Xcode Cloud собирает из репозитория, а не с этой машины.
# Заодно это чинит старую беду — правки Info.plist и Target Membership больше не теряются
# при пересоздании платформы. Игнорим внутри только то, что CI генерит сам (ci_post_clone.sh):
/ios/App/Pods/
/ios/App/App/public/
/ios/App/App/capacitor.config.json
/ios/**/xcuserdata/

# Gradle-вывод локальных плагинов (артефакты сборки, не исходники)
plugins/*/android/build/

# www собирается скриптом ./sync-web.sh из веб-ИП — не коммитим (генерится локально)
www/

# Ключ подписи Android и пароли к нему — НИКОГДА в репозиторий.
# Создаются скриптом scripts/make-keystore.sh, резервная копия — вне проекта.
*.jks
*.keystore
keystore.properties
